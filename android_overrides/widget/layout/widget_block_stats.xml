<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/stat_c1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/stat_v1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#F4EEFF"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/stat_l1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#A99BD0"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/stat_c2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/stat_v2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#F4EEFF"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/stat_l2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#A99BD0"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/stat_c3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/stat_v3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#F4EEFF"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/stat_l3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#A99BD0"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/stat_c4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/stat_v4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#F4EEFF"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/stat_l4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#A99BD0"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
