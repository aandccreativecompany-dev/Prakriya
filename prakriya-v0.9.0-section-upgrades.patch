+
+int _longestRun(Iterable<String> keys) {
+  final days = <int>[];
+  for (final k in keys) {
+    final p = k.split('-');
+    if (p.length != 3) continue;
+    final y = int.tryParse(p[0]);
+    final m = int.tryParse(p[1]);
+    final d = int.tryParse(p[2]);
+    if (y == null || m == null || d == null) continue;
+    days.add(DateTime.utc(y, m, d).millisecondsSinceEpoch ~/ 86400000);
+  }
+  days.sort();
+  var best = 0;
+  var run = 0;
+  int? prev;
+  for (final d in days) {
+    if (prev != null && d == prev) continue;
+    if (prev != null && d == prev + 1) {
+      run++;
+    } else {
+      run = 1;
+    }
+    if (run > best) best = run;
+    prev = d;
+  }
+  return best;
+}
