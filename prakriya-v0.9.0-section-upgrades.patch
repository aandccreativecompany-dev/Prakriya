+      if (extras.checklistDismissed) return const SizedBox.shrink();
+      final hasHabit = store.habits.isNotEmpty;
+      final hasReminder = store.reminders.any((r) => r.enabled);
+      final hasTask = store.state.tasksByDay.values.any((l) => l.isNotEmpty);
+      final hasFocus = extras.totalFocusMinutes > 0;
+      final items = <(bool, String, VoidCallback)>[
+        (hasHabit, 'Add your first habit', onOpenProductivity),
+        (hasTask, 'Write one to-do for today', onOpenProductivity),
+        (hasReminder, 'Turn on a reminder', onOpenReminders),
+        (hasFocus, 'Finish one focus session', onOpenProductivity),
+      ];
+      final doneCount = items.where((i) => i.$1).length;
+      final all = doneCount == items.length;
+      return Padding(
+        padding: const EdgeInsets.only(top: 14),
+        child: ModuleCard(
+          accent: true,
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              BoosterHeader(
+                icon: Icons.flag_outlined,
+                title: all ? 'You are set up' : 'Get started',
+                subtitle: '$doneCount of ${items.length} done',
+                trailing: IconButton(
+                  visualDensity: VisualDensity.compact,
+                  onPressed: extras.dismissChecklist,
+                  icon: Icon(Icons.close, size: 18, color: Surfaces.muted(dark)),
+                ),
+              ),
+              const SizedBox(height: 10),
