+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart' show HapticFeedback;
+
+import '../models.dart';
+import '../services/extras.dart';
+import '../store.dart';
+import '../theme.dart';
+import 'common.dart';
+
+// Lightweight "boost" cards added to the home sections: a focus timer, top-3
+// priorities, habit insights, a money snapshot, quick health logging,
+// gratitude, a daily reach-out nudge, repeat-meal, a first-week checklist and
+// a weekly recap. Every card listens to both the main store and the small
+// extras store, so it updates the instant anything changes.
+
+class _Live extends StatelessWidget {
+  final Widget Function(BuildContext context, bool dark) builder;
+  const _Live(this.builder);
+
+  @override
+  Widget build(BuildContext context) {
+    return AnimatedBuilder(
+      animation: Listenable.merge(<Listenable>[store, extras]),
+      builder: (context, _) =>
+          builder(context, Theme.of(context).brightness == Brightness.dark),
+    );
+  }
+}
+
+class BoosterHeader extends StatelessWidget {
+  final IconData icon;
+  final String title;
+  final String? subtitle;
+  final Widget? trailing;
+  const BoosterHeader({
+    super.key,
+    required this.icon,
+    required this.title,
+    this.subtitle,
+    this.trailing,
+  });
+
+  @override
+  Widget build(BuildContext context) {
+    final dark = Theme.of(context).brightness == Brightness.dark;
+    return Row(
+      crossAxisAlignment: CrossAxisAlignment.start,
+      children: [
+        Icon(icon, size: 20, color: Surfaces.accent(dark)),
+        const SizedBox(width: 10),
+        Expanded(
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              Text(title,
+                  style: body(16, Surfaces.heading(dark), weight: FontWeight.w700)),
+              if (subtitle != null)
+                Padding(
+                  padding: const EdgeInsets.only(top: 2),
+                  child: Text(subtitle!, style: body(12, Surfaces.muted(dark))),
+                ),
+            ],
+          ),
+        ),
+        if (trailing != null) trailing!,
+      ],
+    );
+  }
+}
+
+DateTime _today() {
+  final n = DateTime.now();
+  return DateTime(n.year, n.month, n.day);
+}
+
+DateTime _daysAgo(int n) => _today().subtract(Duration(days: n));
+
+const List<String> _weekLetters = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
+
+// ---------------------------------------------------------------------------
+// Productivity
+// ---------------------------------------------------------------------------
+
+class TopThreeCard extends StatelessWidget {
+  final VoidCallback onAdd;
+  const TopThreeCard({super.key, required this.onAdd});
+
+  @override
+  Widget build(BuildContext context) {
+    return _Live((context, dark) {
+      final tasks = store.todaysTasks;
+      final openIndexes = <int>[];
+      for (var i = 0; i < tasks.length; i++) {
+        if (!tasks[i].done) openIndexes.add(i);
+      }
+      final top = openIndexes.take(3).toList();
+      final doneCount = tasks.where((t) => t.done).length;
+
+      final existing = tasks.map((t) => t.title).toSet();
+      final carry = store
+          .tasksFor(_daysAgo(1))
+          .where((t) => !t.done && !existing.contains(t.title))
+          .toList();
+      final canCarry = extras.carriedOverOn != extras.todayKey && carry.isNotEmpty;
+
+      String subtitle;
+      if (tasks.isEmpty) {
+        subtitle = 'Pick the few things that would make today a win.';
+      } else if (top.isEmpty) {
+        subtitle = 'Everything is done. Enjoy the win.';
+      } else {
+        subtitle = '$doneCount of ${tasks.length} done today';
+      }
+
+      return Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          BoosterHeader(
+            icon: Icons.bolt_rounded,
+            title: 'Top 3 for today',
+            subtitle: subtitle,
+          ),
+          const SizedBox(height: 12),
+          for (final index in top)
+            Padding(
+              padding: const EdgeInsets.only(bottom: 10),
+              child: Row(
+                children: [
+                  CheckSquare(
+                    checked: false,
+                    onTap: () {
+                      HapticFeedback.selectionClick();
+                      store.toggleTask(index);
+                    },
+                  ),
+                  const SizedBox(width: 12),
+                  Expanded(
+                    child: Text(tasks[index].title,
+                        maxLines: 2,
+                        overflow: TextOverflow.ellipsis,
+                        style: body(14.5, Surfaces.bodyText(dark),
+                            weight: FontWeight.w600)),
+                  ),
+                ],
+              ),
+            ),
+          if (canCarry)
+            Padding(
+              padding: const EdgeInsets.only(bottom: 6),
+              child: Wrap(
+                spacing: 8,
+                runSpacing: 4,
+                children: [
+                  ActionChip(
+                    avatar: const Icon(Icons.redo_rounded, size: 16),
+                    label: Text('Carry over ${carry.length} from yesterday'),
+                    onPressed: () async {
+                      for (final t in carry.reversed) {
+                        await store.addTask(t.title);
+                      }
+                      extras.markCarriedOver();
+                    },
+                  ),
+                  TextButton(
+                    onPressed: extras.markCarriedOver,
+                    child: const Text('Skip'),
+                  ),
+                ],
+              ),
+            ),
+          Align(
+            alignment: Alignment.centerLeft,
+            child: OutlinedButton.icon(
+              onPressed: onAdd,
+              icon: const Icon(Icons.add, size: 18),
+              label: Text(tasks.isEmpty ? 'Add your priorities' : 'Open full to-do list'),
+            ),
+          ),
+        ],
+      );
+    });
+  }
+}
+
+class FocusTimerCard extends StatefulWidget {
+  const FocusTimerCard({super.key});
+
+  @override
+  State<FocusTimerCard> createState() => _FocusTimerCardState();
+}
+
+class _FocusTimerCardState extends State<FocusTimerCard> {
+  static const List<int> _lengths = [15, 25, 45];
+  int _minutes = 25;
+  int _remaining = 25 * 60;
+  DateTime? _endsAt;
+  Timer? _timer;
+
+  bool get _running => _endsAt != null;
+
+  @override
+  void dispose() {
+    _timer?.cancel();
+    super.dispose();
+  }
+
+  void _pick(int minutes) {
+    if (_running) return;
+    setState(() {
+      _minutes = minutes;
+      _remaining = minutes * 60;
+    });
+  }
+
+  void _start() {
+    HapticFeedback.mediumImpact();
+    setState(() {
+      _endsAt = DateTime.now().add(Duration(seconds: _remaining));
+    });
+    _timer?.cancel();
+    _timer = Timer.periodic(const Duration(seconds: 1), (_) => _tick());
+  }
+
+  void _tick() {
+    final end = _endsAt;
+    if (end == null) return;
+    final ms = end.difference(DateTime.now()).inMilliseconds;
+    if (ms <= 0) {
+      _finish();
+    } else if (mounted) {
+      setState(() => _remaining = (ms / 1000).ceil());
+    }
+  }
+
+  void _finish() {
+    _timer?.cancel();
+    _timer = null;
+    _endsAt = null;
+    extras.addFocusMinutes(_minutes);
+    HapticFeedback.heavyImpact();
+    if (mounted) {
+      setState(() => _remaining = _minutes * 60);
+      ScaffoldMessenger.of(context)
+        ..hideCurrentSnackBar()
+        ..showSnackBar(SnackBar(
+          behavior: SnackBarBehavior.floating,
+          content: Text('Focus session complete: $_minutes minutes. Take a short break.'),
+        ));
+    }
+  }
+
+  void _stop() {
+    _timer?.cancel();
+    _timer = null;
+    setState(() {
+      _endsAt = null;
+      _remaining = _minutes * 60;
+    });
+  }
+
+  String get _clock {
+    final m = (_remaining ~/ 60).toString().padLeft(2, '0');
+    final s = (_remaining % 60).toString().padLeft(2, '0');
+    return '$m:$s';
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return _Live((context, dark) {
+      final progress = 1 - (_remaining / (_minutes * 60));
+      final streak = extras.focusStreak;
+      final todayMinutes = extras.focusMinutesOn(DateTime.now());
+      return Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          BoosterHeader(
+            icon: Icons.timer_outlined,
+            title: 'Focus timer',
+            subtitle: todayMinutes == 0
+                ? 'One distraction-free block. Start small.'
+                : '$todayMinutes min focused today'
+                    '${streak > 0 ? ' · $streak-day streak' : ''}',
+          ),
+          const SizedBox(height: 14),
+          Center(
+            child: Text(_clock,
