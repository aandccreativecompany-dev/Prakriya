+                style: body(12.5, Surfaces.muted(dark))),
+          ],
+        );
+      }
+      var best = 0;
+      for (final h in habits) {
+        final run = _longestRun(h.completedDays);
+        if (run > best) best = run;
+      }
+      final today = _today();
+      var done30 = 0;
+      for (final h in habits) {
+        done30 += h.completionsInLast(30, today);
+      }
+      final pct30 = (done30 * 100 / (habits.length * 30)).round();
+
+      final yesterday = _daysAgo(1);
+      final doneYesterday = habits.where((h) => h.isDoneOn(yesterday)).length;
+      final doneToday = habits.where((h) => h.isDoneOn(today)).length;
+      final everDone = habits.any((h) => h.completedDays.isNotEmpty);
+      String? nudge;
+      if (doneToday == habits.length) {
+        nudge = 'Every habit done today. That is how identity is built.';
+      } else if (doneYesterday == 0 && doneToday == 0 && everDone) {
+        nudge = 'Missed yesterday? That is okay. Never miss twice: one small habit today keeps the chain alive.';
+      }
+
+      return Column(
