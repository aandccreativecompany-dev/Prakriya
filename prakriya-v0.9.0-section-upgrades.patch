+class WeeklyRecapCard extends StatelessWidget {
+  const WeeklyRecapCard({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    return _Live((context, dark) {
+      if (extras.recapDismissedWeek == extras.thisWeekKey) {
+        return const SizedBox.shrink();
+      }
+      final habits = store.habits;
+      var habitDone = 0;
+      for (final h in habits) {
+        habitDone += h.completionsInLast(7, _today());
+      }
+      var tasksDone = 0;
+      var focus = 0;
+      for (var i = 0; i < 7; i++) {
+        tasksDone += store.tasksFor(_daysAgo(i)).where((t) => t.done).length;
+        focus += extras.focusMinutesOn(_daysAgo(i));
+      }
+      final spent = store.spentThisWeek;
+      final goals = store.weeklyGoals;
+      final goalsDone = goals.where((g) => g.done).length;
+      if (habits.isEmpty && tasksDone == 0 && focus == 0 && spent == 0 && goals.isEmpty) {
+        return const SizedBox.shrink();
+      }
+      final stats = <(String, String)>[
+        ('Habits', habits.isEmpty ? '--' : '$habitDone/${habits.length * 7}'),
+        ('To-dos done', '$tasksDone'),
+        ('Focus', '$focus min'),
+        ('Spent', '₹${spent.toStringAsFixed(0)}'),
+        ('Weekly goals', goals.isEmpty ? '--' : '$goalsDone/${goals.length}'),
+      ];
+      return Padding(
+        padding: const EdgeInsets.only(top: 14),
+        child: ModuleCard(
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              BoosterHeader(
+                icon: Icons.bar_chart_rounded,
+                title: 'Your last 7 days',
+                subtitle: goals.isEmpty
+                    ? 'Set one weekly goal to anchor next week.'
+                    : 'Check in: what is the one thing for this week?',
+                trailing: IconButton(
+                  visualDensity: VisualDensity.compact,
+                  onPressed: extras.dismissRecap,
+                  icon: Icon(Icons.close, size: 18, color: Surfaces.muted(dark)),
+                ),
+              ),
+              const SizedBox(height: 12),
+              Wrap(
+                spacing: 10,
+                runSpacing: 10,
+                children: [
+                  for (final s in stats)
+                    Container(
+                      width: 96,
+                      padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 10),
+                      decoration: BoxDecoration(
+                        color: Surfaces.accent(dark).withValues(alpha: 0.10),
+                        borderRadius: BorderRadius.circular(14),
+                      ),
+                      child: Column(
+                        crossAxisAlignment: CrossAxisAlignment.start,
+                        children: [
+                          Text(s.$2,
+                              maxLines: 1,
+                              overflow: TextOverflow.ellipsis,
+                              style: body(15, Surfaces.heading(dark),
+                                  weight: FontWeight.w800)),
+                          const SizedBox(height: 2),
+                          Text(s.$1,
+                              maxLines: 1,
+                              overflow: TextOverflow.ellipsis,
+                              style: body(10.5, Surfaces.muted(dark))),
+                        ],
+                      ),
+                    ),
+                ],
+              ),
+            ],
+          ),
+        ),
+      );
+    });
+  }
+}
