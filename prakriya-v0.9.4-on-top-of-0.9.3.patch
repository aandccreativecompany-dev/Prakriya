   }
 
+  void _applyPreset(WidgetPreset p) {
+    final rest = kWidgetBlockKeys.where((k) => !p.on.contains(k));
+    extras.applyWidgetLayout(
+      order: <String>[...p.on, ...rest],
+      off: <String>[for (final k in kWidgetBlockKeys) if (!p.on.contains(k)) k],
+      stats: p.stats,
+    );
+  }
